# LLM配置
llm:
  # 提供商: openai / bedrock / zhipu / qwen / deepseek
  provider: openai

  # OpenAI配置
  openai:
    # OpenAI服务的Base URL留空""则使用官方地址
    base_url: ""
    api_key: ""
    model: us.anthropic.claude-opus-4-6-v1
    temperature: 0.7
    max_tokens: 4096

  # AWS Bedrock配置
  bedrock:
    region: us-east-1
    model_id: us.anthropic.claude-opus-4-5-20251101-v1:0
    max_tokens: 4096
    access_key: ""
    secret_key: ""
    session_token: ""

  # 智谱AI配置
  zhipu:
    api_key: ""
    model: glm-4

  # 通义千问配置
  qwen:
    api_key: ""
    model: qwen-max

  # Deepseek配置
  deepseek:
    api_key: ""
    model: deepseek-v4-flash

# 测试执行配置
execution:
  # 超时配置（秒）
  connect_timeout: 5
  read_timeout: 30
  total_timeout: 60

  # 重试配置
  retry:
    max_retries: 2
    retry_interval: 1  # 秒
    retry_on_status: [500, 502, 503, 504]

  # 并发配置
  concurrency:
    enabled: true
    max_workers: 5

  # 依赖失败处理
  dependency_failure: skip  # skip / abort

# 数据库配置
database:
  url: "sqlite:///db/LLMTest.db"
  echo: false
  pool_size: 5
  max_overflow: 10
  pool_timeout: 30
  pool_recycle: 3600

# ChromaDB 向量数据库配置
chroma:
  host: "localhost"
  port: 8000
  auth_provider: "chromadb.auth.token_authn.TokenAuthClientProvider"
  auth_credentials: ""
  auth_token_transport_header: "Authorization"
  tenant: "default_tenant"
  database: "default_database"
  default_collection: "default"

# 日志配置
logging:
  level: INFO  # DEBUG / INFO / WARNING / ERROR
  format: console  # console (彩色开发输出) / json (生产环境JSON输出)

# LangSmith 可观测性配置
langsmith:
  enabled: false  # 设为 true 启用 LangSmith 追踪
  api_key: ""
  project: LLMTestAgent
  endpoint: https://api.smith.langchain.com
