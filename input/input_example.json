{
  "domain": "https://httpbin.org",
  "apis": [
    {
      "name": "用户登录",
      "url": "/post",
      "method": "POST",
      "headers": {
        "Content-Type": "application/json",
        "User-Agent": "LLMTestAgent/1.0"
      },
      "body": {
        "username": "testuser",
        "password": "testpass123"
      },
      "assert_rules": [
        "$.json.username == testuser",
        "$.json.password == testpass123"
      ],
      "priority": "P0",
      "description": "用户登录接口，验证用户名密码"
    },
    {
      "name": "获取用户信息",
      "url": "/get",
      "method": "GET",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer test_token_12345"
      },
      "assert_rules": [
        "$.headers.Authorization != null",
        "$.url contains httpbin.org"
      ],
      "dependencies": {
        "用户登录": {
          "source_path": "$.json.username",
          "target_param": "headers.X-Username"
        }
      },
      "priority": "P0",
      "description": "获取当前登录用户的详细信息"
    },
    {
      "name": "更新用户信息",
      "url": "/put",
      "method": "PUT",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer test_token_12345"
      },
      "body": {
        "nickname": "测试昵称",
        "email": "test@example.com",
        "age": 25
      },
      "assert_rules": [
        "$.json.nickname == 测试昵称",
        "$.json.email == test@example.com",
        "$.json.age == 25"
      ],
      "dependencies": {
        "用户登录": {
          "source_path": "$.json.username",
          "target_param": "body.username"
        }
      },
      "priority": "P1",
      "description": "更新用户个人信息"
    },
    {
      "name": "删除用户",
      "url": "/delete",
      "method": "DELETE",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer admin_token_12345"
      },
      "assert_rules": [
        "$.url contains httpbin.org"
      ],
      "priority": "P2",
      "description": "删除指定用户（管理员权限）"
    }
  ]
}
