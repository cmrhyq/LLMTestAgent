{
  "domain": "https://jsonplaceholder.typicode.com",
  "apis": [
    {
      "name": "user_list",
      "url": "/users",
      "method": "GET",
      "headers": {
        "Abc": "json"
      },
      "params": {},
      "body": {},
      "cache_rules": {
        "id": "$[0].id"
      },
      "assert_rules": [
        "$[0].username == Bret",
        "$[0].id == 1"
      ],
      "priority": "P0",
      "description": "用户列表接口，展示拥有的用户"
    },
    {
      "name": "get_user_by_id",
      "url": "/users/{{cache:id}}",
      "method": "GET",
      "headers": {
        "Abc": "json"
      },
      "params": {},
      "body": {},
      "cache_rules": {
        "username": "$.username"
      },
      "assert_rules": [
        "$.username == Bret",
        "$.id == 1"
      ],
      "priority": "P0",
      "description": "根据 ID 获取用户信息"
    },
    {
      "name": "get_user_posts",
      "url": "/users/{{cache:id}}/posts",
      "method": "GET",
      "headers": {
        "Abc": "json"
      },
      "params": {},
      "body": {},
      "cache_rules": {
        "username": "$.username"
      },
      "assert_rules": [
        "$[0].id == 1"
      ],
      "priority": "P0",
      "description": "根据 ID 获取用户信息"
    }
  ]
}
